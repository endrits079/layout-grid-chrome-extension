{
  "manifest_version": 3,
  "name": "Grid Overlay Tool",
  "version": "1.0",
  "description": "Add customizable grid overlays to any webpage for alignment checking",
  "author": "Endrit Shabani",
  "homepage_url": "https://github.com/endrits079/layout-grid-chrome-extension",
  "permissions": ["activeTab", "storage", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["grid.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grid Overlay Tool"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
